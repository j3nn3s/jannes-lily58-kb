#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Activate ADJUST layer by pressing raise and lower
    behaviors {
        raise_layer_tap_signal: raise-layer-tap-signal {
            compatible = "behaviors.hold-tap";
            bindings = <&mo 1 &kp F13>, <&kp ESCAPE>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };
        lower_layer_toggle_signal: lower-layer-toggle-signal {
            compatible = "behaviors.composite";
            bindings = <&tog 2 &kp F14>;
        };
        layer3_toggle_signal: layer3-toggle-signal {
            compatible = "behaviors.composite";
            bindings = <&tog 3 &kp F15>;
        };
    };
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |RGB_TOG|  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp GRAVE     &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                                                      &kp N6               &kp N7     &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB       &kp Q   &kp W   &kp E   &kp R     &kp T                                                       &kp Y                &kp U      &kp I      &kp O    &kp P      &kp LC(BACKSPACE)
&raise_layer_tap_signal  &kp A   &kp S   &kp D   &kp F     &kp G                                                       &kp H                &kp J      &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT     &kp Z   &kp X   &kp C   &kp V     &kp B                &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N                &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp RSHFT
                &lower_layer_toggle_signal  &kp LALT  &mt LEFT_META SPACE  &kp SPACE           &kp RET            &mt LCTRL BACKSPACE  &kp EQUAL  &kp BSLH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |EXTPWR |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp GRAVE    &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)   &kp LA(NUMBER_4)  &kp LA(N5)                                                             &kp LA(NUMBER_6)  &kp LA(N7)        &kp LA(N8)                &kp LA(N9)        &kp LA(N0)     &kp RC(MINUS)
&kp LC(TAB)  &kp RC(Q)         &kp RC(W)         &kp LC(LS(RIGHT))  &kp LC(LS(R))     &kp LC(T)                                                              &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)          &kp LA(NUMBER_4)  &kp LA(N5)     &kp DEL
&trans       &kp LC(A)         &kp LC(S)         &kp LC(D)          &kp LC(F)         &kp LS(LC(G))                                                          &kp LEFT          &kp DOWN_ARROW    &kp UP_ARROW              &kp RIGHT         &kp LC(P)      &kp LC(RS(P))
&trans       &kp LC(Z)         &kp LC(X)         &kp LC(RS(C))      &kp LC(LS(V))     &kp LC(LS(LEFT_ARROW))  &kp LC(LEFT_BRACKET)    &kp LC(RIGHT_BRACKET)  &kp LC(N)         &kp LC(M)         &kp LC(COMMA)             &kp RC(PERIOD)    &kp LC(SLASH)  &trans
                                    &layer3_toggle_signal             &trans            &trans                  &kp LC(SPACE)           &kp LC(ENTER)          &trans            &kp LC(EQUAL)     &kp LC(NON_US_BACKSLASH)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans  &trans  &trans      &trans             &trans           &bt BT_CLR_ALL                    &trans  &trans                  &trans                &trans                &trans           &trans
&trans  &trans  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans                            &trans  &kp C_BACKLIGHT_TOGGLE  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp PRINTSCREEN  &kp DELETE
&kp F1  &kp F2  &kp F3      &kp F4             &kp F5           &kp F6                            &kp F7  &kp F8                  &kp F9                &kp F10               &kp F11          &kp F12
&trans  &trans  &trans      &trans             &trans           &trans          &trans    &trans  &trans  &trans                  &trans                &trans                &trans           &trans
                            &trans             &trans           &trans          &trans    &trans  &trans  &trans                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming_layer {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4             &kp N5                                            &kp N6                   &kp N7     &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R              &kp T                                             &kp Y                    &kp U      &kp I      &kp O    &kp P      &kp LC(BACKSPACE)
&kp LCTRL  &kp A   &kp S   &kp D   &kp F              &kp G                                             &kp H                    &kp J      &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V              &kp B      &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N                    &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp RSHFT
                       &layer3_toggle_signal  &kp RIGHT_CONTROL  &kp SPACE  &kp SPACE           &kp RET            &mt LEFT_META BACKSPACE  &kp EQUAL  &kp BSLH
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
